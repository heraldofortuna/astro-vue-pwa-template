---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout title="Astro Vue PWA Boilerplate - Página 3">
  <Header />
  <main class="p-6 flex-1 flex flex-col justify-between">
    <!-- Welcome -->
    <div
      class="max-w-xl mx-auto flex flex-col justify-center flex-1 space-y-10">
      <div class="flex flex-col gap-8 text-center">
        <h1 class="text-2xl md:text-4xl font-semibold"
          >🟢 Astro Vue PWA Boilerplate de Culqi</h1
        >
        <p class="italic text-lg md:text-xl">Estamos en la página 3</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
